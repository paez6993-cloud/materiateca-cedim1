# Supabase — copia estas desde tu proyecto en supabase.com > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo en el servidor (nunca en el navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — para enviar correos (resend.com > API Keys)
RESEND_API_KEY=re_...
NOTIFICATION_EMAIL=ivette@cedim.edu.mx

# Cloudflare Turnstile — captcha gratuito (dash.cloudflare.com > Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# URL base del sitio (sin slash final)
NEXT_PUBLIC_SITE_URL=https://materiateca.netlify.app
